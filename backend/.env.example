# Copy to .env (git-ignored). Never commit real values.

# Port the API listens on. The Android emulator reaches it at http://10.0.2.2:3000/
PORT=3000

# PostgreSQL connection string (Neon free tier works). Leave unset to use the
# in-memory store, which is fine for local demos and is what the tests use.
# DATABASE_URL=postgres://user:password@host:5432/habitable?sslmode=require

# Secret used to sign JWTs. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-before-deploying

# Token lifetime
JWT_EXPIRES_IN=30d
